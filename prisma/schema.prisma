datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// USER & AUTHENTICATION (Auth.js / NextAuth v5 standard)
// -------------------------------------------------------------
model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  portfolio     Portfolio?

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------------------------------------------------
// PORTFOLIO CORE
// -------------------------------------------------------------
enum PortfolioStatus {
  DRAFT
  PUBLISHED
}

model Portfolio {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  slug           String          @unique
  status         PortfolioStatus @default(DRAFT)
  publishedAt    DateTime?
  
  // Visual Theme Configuration
  templateId     String          @default("minimalist") // "minimalist" | "bold" | "developer" | "elegant"
  accentColor    String          @default("#2563eb")
  fontFamily     String          @default("Inter")
  customCss      String?         @db.Text
  sectionOrder   Json?           // ["about", "skills", "projects", "experience", "education", "certifications", "testimonials", "contact"]
  hiddenSections Json?           // e.g. ["testimonials"]

  // SEO & Meta Tags
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  // Section Relations
  profile        Profile?
  about          About?
  contactInfo    ContactInfo?
  experiences    Experience[]
  educations     Education[]
  skills         Skill[]
  projects       Project[]
  certifications Certification[]
  testimonials   Testimonial[]
  socialLinks    SocialLink[]
  analytics      Analytics[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([slug])
}

// -------------------------------------------------------------
// PORTFOLIO SECTIONS
// -------------------------------------------------------------
model Profile {
  id               String    @id @default(cuid())
  portfolioId      String    @unique
  portfolio        Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  fullName         String
  headline         String    // e.g. "Full-Stack Engineer & Designer"
  avatarUrl        String?
  bannerUrl        String?
  location         String?   // e.g. "Jakarta, Indonesia"
  availableForHire Boolean   @default(true)
  hireBadgeText    String?   @default("Available for work")
  resumePdfUrl     String?   // Optional URL to PDF CV
  
  updatedAt        DateTime  @updatedAt
}

model About {
  id               String    @id @default(cuid())
  portfolioId      String    @unique
  portfolio        Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  bio              String    @db.Text
  keyHighlights    Json?     // Array of short strings e.g. ["5+ Years Exp", "10+ Production Apps"]
  
  updatedAt        DateTime  @updatedAt
}

model ContactInfo {
  id                String    @id @default(cuid())
  portfolioId       String    @unique
  portfolio         Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  email             String?
  phone             String?
  whatsapp          String?
  enableContactForm Boolean   @default(true)
  
  updatedAt         DateTime  @updatedAt
}

model SocialLink {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  platform    String    // "github", "linkedin", "twitter", "dribbble", "instagram", "youtube", "website"
  url         String
  order       Int       @default(0)

  @@index([portfolioId])
}

model Experience {
  id             String    @id @default(cuid())
  portfolioId    String
  portfolio      Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  company        String
  companyUrl     String?
  position       String
  employmentType String?   // "Full-time", "Part-time", "Contract", "Freelance", "Internship"
  location       String?
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean   @default(false)
  description    String?   @db.Text
  order          Int       @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([portfolioId])
}

model Education {
  id           String    @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  institution  String
  degree       String    // e.g. "Bachelor of Computer Science"
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  gpa          String?
  description  String?   @db.Text
  order        Int       @default(0)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([portfolioId])
}

model Skill {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  name        String
  category    String?   // "Frontend", "Backend", "Design", "Tools", "Soft Skills"
  level       String?   // "Beginner", "Intermediate", "Advanced", "Expert"
  order       Int       @default(0)

  @@index([portfolioId])
}

model Project {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  title       String
  tagline     String?
  description String    @db.Text
  imageUrl    String?
  galleryUrls Json?     // Array of strings
  tags        Json?     // Array of strings e.g. ["Next.js", "Tailwind", "TypeScript"]
  liveUrl     String?
  githubUrl   String?
  isFeatured  Boolean   @default(false)
  order       Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([portfolioId])
}

model Certification {
  id            String    @id @default(cuid())
  portfolioId   String
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  title         String
  issuer        String
  issueDate     DateTime
  expiryDate    DateTime?
  credentialId  String?
  credentialUrl String?
  order         Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([portfolioId])
}

model Testimonial {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  name        String
  role        String    // e.g. "Lead Designer at Studio"
  company     String?
  quote       String    @db.Text
  avatarUrl   String?
  order       Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([portfolioId])
}

// -------------------------------------------------------------
// ANALYTICS & EVENT LOGGING
// -------------------------------------------------------------
model Analytics {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  eventType   String    // "page_view", "link_click", "contact_click"
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([portfolioId, createdAt])
}
