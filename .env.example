# Database Configuration (PostgreSQL)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/portfolio_builder?schema=public"

# Auth.js / NextAuth Configuration
# Generate a secure secret with: openssl rand -base64 32
AUTH_SECRET="portfolio-builder-super-secret-key-32chars-minimum-replace-in-prod"
NEXTAUTH_URL="http://localhost:3000"

# Storage Provider Configuration ("local" | "cloudinary" | "supabase")
STORAGE_PROVIDER="local"
UPLOAD_MAX_FILE_SIZE_MB=2
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp"

# Optional Cloud Storage Credentials (for future migration)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# SUPABASE_URL=""
# SUPABASE_KEY=""
